# ============================================
# AIR OS V2 - Git Ignore
# ============================================

# Secrets / API keys / environment variables
.env
.env.*
*.env
secrets.json
credentials.json
config.local.json

# Personal / local user data
contacts.json

# Python cache
__pycache__/
*.py[cod]
*.pyo

# Python virtual environments
.venv/
venv/
env/

# Logs / temporary files
*.log
*.tmp
*.temp

# VS Code / IDE
.vscode/
.idea/

# Windows / macOS
Thumbs.db
.DS_Store

# Python tool caches
.pytest_cache/
.mypy_cache/

# Build output
build/
dist/

# Local AIR OS configuration
airos_settings.json